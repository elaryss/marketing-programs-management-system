# Marketing Program Management System — environment variable names
#
# This file lists the credential names the system expects. Actual values
# live in the n8n Cloud credential vault, NOT in this repo.
#
# When configuring n8n Cloud, create credentials matching these names so
# workflows imported from /workflows/ bind correctly.
#
# DO NOT commit a populated .env file. .env is gitignored.

# Airtable — base: appktJRFtPhgZY4ln
AIRTABLE_PAT=
AIRTABLE_BASE_ID=

# Anthropic Claude API
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Tavily — web research for Brief Research agent
TAVILY_API_KEY=

# n8n Cloud — webhook base for Airtable automations triggering workflows
N8N_WEBHOOK_BASE_URL=

# Gmail OAuth — for email intake workflow (Gmail Trigger node)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# Supabase — toolkit_manager.html and any future site/ pages.
# At build time these are injected into site/config.local.js by
# scripts/build-config.js. On Vercel, set them in the project's
# Environment Variables section (Production + Preview + Development).
SUPABASE_URL=
SUPABASE_ANON=

# Supabase service role — server-only, read by api/chat.js.
# NEVER exposed to the browser. Not passed through scripts/build-config.js.
# In Vercel: add as a regular env var; don't prefix with NEXT_PUBLIC_ or similar.
SUPABASE_SERVICE_ROLE_KEY=
